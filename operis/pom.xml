<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version> <relativePath/>
    </parent>

    <groupId>com.operis</groupId>
    <artifactId>operis</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>operis</name>
    <description>Demo project for Spring Boot</description>

    <packaging>pom</packaging>

    <!-- MODULES -->
    <modules>
        <module>operis-project</module>
        <module>operis-discovery</module>
        <module>operis-gateway</module>
        <module>operis-config</module>
    </modules>

    <properties>
        <java.version>23</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- version pour Spring Cloud 2024.0.0 corresponds to Spring Boot 3.4.x - BOM (Bill of Materials) -->
        <!-- Une liste centralisée des versions des dépendances Spring Cloud -->
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <!-- version pour Spring Cloud Gateway 2024.0.0 corresponds to Spring Boot 3.4.x -->
        <spring-cloud-gateway-dependencies.version>2024.0.0</spring-cloud-gateway-dependencies.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>